{
  "work_dir": ".",
  "state_file": "{stem}.pipeline.json",
  "variables": {
    "python": "{script_dir}/cut/.venv~/bin/python"
  },
  "steps": [
    {
      "name": "audio",
      "description": "Извлечь mono WAV 16 kHz",
      "program": "ffmpeg",
      "inputs": {
        "video": "{video}"
      },
      "outputs": {
        "wav": "{work_dir}/{stem}.wav"
      },
      "args": [
        "-y",
        "-i", "{inputs.video}",
        "-vn",
        "-acodec", "pcm_s16le",
        "-ar", "16000",
        "-ac", "1",
        "{outputs.wav}"
      ]
    },
    {
      "name": "vad",
      "description": "Вырезать участки с речью (Silero VAD) и построить карту таймкодов",
      "program": "{vars.python}",
      "cwd": "{script_dir}",
      "inputs": {
        "wav": "@audio.wav"
      },
      "outputs": {
        "wav": "{work_dir}/{stem}_vad.wav",
        "map": "{work_dir}/{stem}_vad_map.json"
      },
      "args": [
        "{script_dir}/vad.py",
        "{inputs.wav}",
        "-o", "{outputs.wav}",
        "-j", "{outputs.map}",
        "--state-reset-sec", "10",
        "--gap-sec", "1"
      ]
    },
    {
      "name": "separator",
      "description": "Делим аудио на музыку и речь",
      "program": "{vars.python}",
      "cwd": "{script_dir}",
      "inputs": {
        "wav": "@vad.wav"
      },
      "outputs": {
        "wav": "{work_dir}/{stem}_speech.wav"
      },
      "args": [
        "{script_dir}/separator_speech.py",
        "{inputs.wav}",
        "{outputs.wav}"
      ]
    },
    {
      "name": "whisper",
      "description": "Распознать греческую речь",
      "program": "/Users/ivansh/projects/whisper.cpp/build-release/bin/whisper-cli",
      "inputs": {
        "wav": "@separator.wav"
      },
      "outputs": {
        "srt": "{work_dir}/{stem}_vad.srt"
      },
      "args": [
        "-m", "/Users/ivansh/projects/models/ggml-large-v3.bin",
        "-f", "{inputs.wav}",
        "-l", "el",
        "-osrt",
        "-of", "{work_dir}/{stem}_vad",
        "-pp",
        "-t", "1",
        "-bs", "5"
      ]
    },
    {
      "name": "unmap",
      "description": "Пересчитать таймкоды SRT из VAD-шкалы в исходную",
      "program": "{vars.python}",
      "cwd": "{script_dir}",
      "inputs": {
        "srt": "@whisper.srt",
        "map": "@vad.map"
      },
      "outputs": {
        "srt": "{work_dir}/{stem}.srt"
      },
      "args": [
        "{script_dir}/vad_unmap.py",
        "{inputs.srt}",
        "{inputs.map}",
        "-o", "{outputs.srt}"
      ]
    },
    {
      "name": "translate",
      "description": "Перевести SRT на русский",
      "program": "{vars.python}",
      "cwd": "{script_dir}",
      "inputs": {
        "srt": "@unmap.srt"
      },
      "outputs": {
        "ru_srt": "{work_dir}/{stem}_ru.srt"
      },
      "args": [
        "{script_dir}/translate.py",
        "{inputs.srt}",
        "el",
        "ru"
      ]
    },
    {
      "name": "ass",
      "description": "Собрать двуязычный ASS",
      "inputs": {
        "video": "{video}",
        "srt": "@unmap.srt",
        "ru_srt": "@translate.ru_srt"
      },
      "outputs": {
        "ass": "{work_dir}/{stem}.ass"
      },
      "commands": [
        {
          "program": "ffprobe",
          "args": [
            "-v", "error",
            "-select_streams", "v:0",
            "-show_entries", "stream=display_aspect_ratio",
            "-of", "default=noprint_wrappers=1:nokey=1",
            "{inputs.video}"
          ],
          "capture": "aspect_ratio",
          "default": "16:9",
          "validate": "^[0-9]+:[0-9]+$"
        },
        {
          "program": "{vars.python}",
          "args": [
            "{script_dir}/convert_to_ass.py",
            "{inputs.srt}",
            "{vars.aspect_ratio}"
          ]
        }
      ]
    },
    {
      "name": "publish",
      "description": "Скопировать ASS в папку видео",
      "program": "cp",
      "inputs": {
        "ass": "@ass.ass"
      },
      "outputs": {
        "published": "{video_dir}/{stem}.ass"
      },
      "args": [
        "-f",
        "{inputs.ass}",
        "{outputs.published}"
      ]
    }
  ]
}
